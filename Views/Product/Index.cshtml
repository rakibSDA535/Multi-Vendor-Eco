@using Shop111.Models
@model IEnumerable<Product>
@{
    Layout = "_AdminLayout";
    // ViewBag থেকে পেজিনেশন তথ্য নিন
    string searchQuery = ViewBag.SearchQuery;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int pageSize = ViewBag.PageSize;
    int totalItems = ViewBag.TotalItems;
}

<h2>Products</h2>
<div class="row mb-3">
    <div class="col-md-4">
        <a asp-action="AddProduct" asp-controller="Product" class="btn btn-primary">➕Add Product</a>
    </div>

    <div class="col-md-4 d-flex align-items-center">
        <form asp-action="Index" method="get" class="d-flex w-100">
            <label for="pageSize" class="me-2 mt-1 text-nowrap">Show Items:</label>
            <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="5" selected="@(pageSize == 5)">5</option>
                <option value="6" selected="@(pageSize == 6)">6</option>
                <option value="7" selected="@(pageSize == 7)">7</option>
                <option value="8" selected="@(pageSize == 8)">8</option>
                <option value="9" selected="@(pageSize == 9)">9</option>
                <option value="10" selected="@(pageSize == 10)">10</option>
                <option value="15" selected="@(pageSize == 15)">15</option>
                <option value="20" selected="@(pageSize == 20)">20</option>
                <option value="@totalItems" selected="@(pageSize == totalItems)">All</option>
            </select>
            <input type="hidden" name="searchQuery" value="@searchQuery" /> 
            <input type="hidden" name="page" value="1" />
        </form>
    </div>

    <div class="col-md-4">
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchQuery" class="form-control me-2" placeholder="Search by Product/Company Name" value="@searchQuery" />
            <button type="submit" class="btn btn-secondary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
            <input type="hidden" name="pageSize" value="@pageSize" />
        </form>
    </div>
</div>
@* <a asp-action="AddProduct" asp-controller="Product" class="btn btn-primary">Add More</a> *@


@if (Model?.Count() > 0)
{
    <table class="table table-striped my-2">
        <tr>
            <th>Image</th>
            <th>Product</th>
            <th>Company</th>
            <th>Create</th>
            <th>Stock</th>
            <th>Date</th>
            <th>OnSale</th>
            <th>Price</th>
            <th>Action</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>
                    @if (string.IsNullOrWhiteSpace(product.Image))
                    {
                        <img src="/Images/114320.jpg" style="width:100px;height:100px" alt="product image" />
                    }
                    else
                    {
                        <img src="/Images/@product.Image" style="width:100px;height:100px" alt="product image" />
                    }
                </td>
                <td>@product.ProductName</td>
                <td>@product.CompanyName</td>
                <td>@product.Genre.GenreName</td>
                <td>@(product.Stock?.Quantity ?? 0)</td>
                <td>@product.ReleaseDate.ToShortDateString()</td>
                @* <td>@product.OnSale</td> *@
                <td>
                    @if (product.OnSale)
                    {
                        <span class="badge py-1 px-2 bg-success">On Sale</span>
                    }
                    else
                    {
                        <span class="badge py-1 px-2 bg-warning">Regular</span>
                    }
                </td>
                <td>@product.Price</td>              

                <td>
                    <a asp-action="UpdateProduct" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-success">Edit</a>|❤️|
                    <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-info">Detail</a>|❤️|

                    <a asp-action="DeleteProduct" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-danger" onclick="return window.confirm('Are you sure to delete?')">Delete</a>
                </td>
            }
            </tr>
            @*==============================================================================================*@
            @if (product.ProductInformations != null && product.ProductInformations.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="ms-4">
                            <strong>Additional Information:</strong>
                            <table class="table table-sm table-striped mt-1 mb-0 border">
                                <thead>
                                    <tr class="bg-light">
                                        <th style="width:50%">Description</th>
                                        <th style="width:50%">Made In</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in product.ProductInformations)
                                    {
                                        <tr>
                                            @* <td>@detail.Description</td> *@
                                            <td>@Html.Raw(detail.Description?.Replace("\n", "<br />"))</td>
                                            <td>@detail.MadeIn</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
            
            
        }
    </table>

    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchQuery="@searchQuery" asp-route-page="1" asp-route-pageSize="@pageSize">First</a>
                </li>
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchQuery="@searchQuery" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-searchQuery="@searchQuery" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchQuery="@searchQuery" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Next</a>
                </li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchQuery="@searchQuery" asp-route-page="@totalPages" asp-route-pageSize="@pageSize">Last</a>
                </li>
            </ul>
        </nav>
        <p>Page @currentPage of @totalPages. Total items: @totalItems</p>
    }
}
else
{
    <h3>No records found.</h3>
}


