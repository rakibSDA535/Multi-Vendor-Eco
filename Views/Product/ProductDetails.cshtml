@model Shop111.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/Images/@Model.Image" class="img-fluid rounded" alt="@Model.ProductName" />
                }
                else
                {
                    <img src="~/Images/114320.jpg" class="img-fluid rounded" alt="No Image" />
                }
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <h3 class="card-title">@Model.ProductName</h3>
                    <h5 class="text-muted">Company: @Model.CompanyName</h5>

                    <p class="mt-3">
                        <strong>Genre:</strong> @Model.GenreName <br />
                        <strong>Price:</strong> 💰@Model.Price <br />
                        <strong>Stock:</strong> 📦 @(Model.Stock != null ? Model.Stock.Quantity.ToString() : "N/A") <br />
                        <strong>Date:</strong> @Model.ReleaseDate.ToShortDateString() <br />
                        <strong>Sale:</strong>
                            @if (Model.OnSale)
                            {
                                <span class="badge py-1 px-2 bg-success">On Sale</span>
                            }
                            else
                            {
                                <span class="badge py-1 px-2 bg-warning">Regular</span>
                            }
                        <br />
                        <strong>Product ID:</strong> @Model.Id
                    </p>

                    @* Product Information / Details Table *@
                    @if (Model.ProductInformations != null && Model.ProductInformations.Any())
                    {
                        <h5 class="mt-4">Additional Information</h5>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Made In</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.ProductInformations)
                                {
                                    <tr>
                                        <td>@Html.Raw(detail.Description?.Replace("\n", "<br />")))</td>
                                        <td>@detail.MadeIn</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @* End of Product Information Table *@

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <a asp-action="UpdateProduct" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                        <a asp-action="DeleteProduct" asp-route-id="@Model.Id"
                           class="btn btn-danger"
                           onclick="return confirm('Are you sure you want to delete this product?');">
                            Delete
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
