}

/* Glow Effect */
.glow-container {
    position: relative;
    display: inline-block;
}

.glow-effect {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(255, 0, 0, 0.5), transparent 70%);
    filter: blur(40px);
    border-radius: 50%;
    animation: pulse-red 2.5s infinite;
}

