@* @using Shop111.Models.DTOs *@
@model ProductDisplayModel
@{
    ViewData["Title"] = "Product Display"; // tytle
}
<div class="my-4 product-filter-section full-width-row mt-2" style=" z-index: 1030;">
    <form asp-action="Index" class="row g-3 align-items-center justify-content-start full-width-row" method="get" id="filterForm">
        <div class="col-auto">
            <label class="visually-hidden" for="genreId">Genres</label>
            <select class="form-select" id="genreId" name="genreId">
                <option value="" selected>Filter by Created</option> @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                }
            </select>
        </div>

        <div class="col-auto ">
            <label class="visually-hidden" for="sterm">Search by title</label>
            <div class="input-group">
                <div class="input-group-text input-group-text-custom">
                    <i class="bi bi-search"></i>
                </div>
                <input type="text" class="form-control" value="@Model.STerm" id="sterm" name="sterm" placeholder="Search by Product">
            </div>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-success">Search</button>
        </div>
        <div class="col-auto">
            <a href="/Home/Index" class="btn btn-info">Reset</a>
        </div>

        @*price range slider + reset button*@
        <div style="min-width:250px;">
            <h5>Price Range</h5>

            <p>
                Find With Price: <strong id="priceValue" name="priceValue">@ViewBag.MaxPrice</strong>
            </p>
            <div class="mt-2" style="width:250px;">
                <input type="range"
                       id="priceSlider"
                       min="0"
                       max="100000"
                       value="@ViewBag.MaxPrice"
                       style="width:100%; cursor:pointer; accent-color: red;"
                       oninput="updateFromSlider(this.value)"
                       onchange="submitForm()" />
                <div class="flex-grow-1">
                    <label class="small">Min ($)</label>
                    <input type="number"
                           id="minInput"
                           name="minPrice"
                           class="form-control form-control-sm"
                           value="@ViewBag.MinPrice"
                           oninput="if(this.value < 0) this.value = 0;"
                           onchange="syncSliderAndSubmit()" />
                </div>
                <div class="flex-grow-1">
                    <label class="small">Max ($)</label>
                    <input type="number"
                           id="maxInput"
                           name="maxPrice"
                           class="form-control form-control-sm"
                           value="@ViewBag.MaxPrice"
                           oninput="if(this.value < 0) this.value = 0;"
                           onchange="syncSliderAndSubmit()" />
                </div>
            </div>
        </div>
       @*price range slider + reset button*@
       @*Carousel Effect top sold product*@
       <div class="container-fluid px-0 mt-3" style="width:75%;">

            @if (Model.TopNSoldProducts != null && Model.TopNSoldProducts.Any())
            {
                <div id="bannerCarousel" class="carousel slide hero-banner shadow-lg" data-bs-ride="carousel">

                    <!-- Indicators -->
                    <div class="carousel-indicators">
                        @{
                            int j = 0;
                        }
                        @foreach (var item in Model.TopNSoldProducts)
                        {
                            <button type="button"
                                    data-bs-target="#bannerCarousel"
                                    data-bs-slide-to="@j"
                                    class="@(j==0 ? "active" : "")">
                            </button>
                            j++;
                        }
                    </div>

                    <div class="carousel-inner">
                        @{
                            int i = 0;
                        }

                        @foreach (var item in Model.TopNSoldProducts)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="4000">

                                <div class="row align-items-center p-4 p-md-5">

                                    <!-- Left Content -->
                                    <div class="col-md-7 text-white ps-lg-5">
                                        <h1 class="display-4 fw-bold mb-3 text-gradient">
                                            @item.ProductName
                                        </h1>
                                        <p class="lead text-light mb-4" >
                                             <span class="fw-semibold" style="color:black">Total Sold:@item.TotalUnitSold</span> 
                                        </p>
                                        <p class="lead text-light mb-4">
                                             <span class="fw-semibold" style="color:black">Produced by:@item.CompanyName</span>
                                        </p>

                                    </div>

                                    <!-- Right Image -->
                                    <div class="col-md-5 text-center mt-4 mt-md-0">
                                        <div class="glow-container">
                                            <div class="glow-effect"></div>

                                            <img src="/Images/@(string.IsNullOrEmpty(item.Image) ? "no-symbol.jpg" : item.Image)"
                                                 class="banner-img"
                                                 alt="@item.ProductName" />
                                        </div>
                                    </div>

                                </div>

                            </div>

                            i++;
                        }
                    </div>

                    <!-- Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon custom-arrow"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon custom-arrow"></span>
                    </button>

                </div>
            }
        </div>
        @*Carousel Effect top sold product*@
    </form>
</div>




@*Picture Section*@
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-6 g-2 mt-4 full-width-row">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <div class="card custom-card">
                @*Normal pic show(S1)*@
                @* @if (string.IsNullOrEmpty(product.Image))
                {
                    <img src="/Images/no-symbol.jpg" class="card-img-top-custom" alt="No image available">
                }
                else
                {
                    <img src="/Images/@product.Image" class="card-img-top-custom" alt="@product.ProductName Image">
                } *@
                @*On click Picture to show details (S2)*@
                @{
                    // imageUrl ভেরিয়েবলটি সংজ্ঞায়িত করা হলো, যা ছবিটি না থাকলে ডিফল্ট ছবি Path দেবে
                    string imageUrl = string.IsNullOrWhiteSpace(product.Image) ? "/Images/no-symbol.jpg" : $"/Images/{product.Image}";

                    // ছবির নামের জন্য alt Text সেট করা হলো
                    string altText = string.IsNullOrWhiteSpace(product.Image) ? "No image available" : $"{product.ProductName} Image";
                }
                <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="d-block">
                    <img src="@imageUrl"
                         class="card-img-top-custom"
                         style="width: 100%;  object-fit: cover;"
                         alt="@altText">
                </a>
                <div class="card-body card-body-custom d-flex flex-column">
                    <div class="favorite-btn-overlay d-flex align-items-start mb-2">
                        <h5 class="card-title text-info fw-bold me-auto mb-0">@product.ProductName</h5>
                        <button type="button" onclick="add(@product.Id)" class="btn btn-outline-danger" id="favoriteButton_@product.Id" style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .75rem;">
                            <i class="bi bi-heart btn-outline-danger"></i>
                        </button>
                    </div>
                    
                    <p class="card-text mb-2">
                        <b class="card-text text-black"> Create: </b>@product.GenreName <br />
                        <b class="card-text text-black">Company: </b>@product.CompanyName
                    </p>
                    <span class="product-price">৳ @product.Price</span>

                    <div class="mt-3">
                        @if (product.Quantity > 0)
                        {
                            <button type="button" onclick="add(@product.Id)" class="btn btn-sm btn-cart-custom me-1 mb-1">
                                <i class="bi bi-cart-plus"></i> Add to cart
                            </button>
                        }
                        else
                        {
                            <span class="out-of-stock-badge me-1 mb-1">Out of stock</span>
                        }
                        @* <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" type="button" class="btn btn-sm btn-details-custom me-1 mb-1">Detail</a> *@
                        <button type="button" onclick="showProductDetailsAndBuy(@product.Id)" class="btn btn-sm btn-buy-custom mb-1">Buy Now</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
