@section Scripts {
    <script>
        // টোস্ট অবজেক্ট তৈরি করুন
        var toastEl = document.getElementById('addToCartToast');
        var cartToast = new bootstrap.Toast(toastEl, {
            autohide: true,
            delay: 3000 // ৩ সেকেন্ড পর নিজে থেকে বন্ধ হয়ে যাবে
        });
        // আপনার জাভাস্ক্রিপ্ট কোড
        async function add(productId) {
            var usernameEl = document.getElementById("username");
            if (usernameEl == null) {
                window.location.href = "/Identity/Account/Login";
            }
            try {
                var response = await fetch(`/Cart/AddItem?productId=${productId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    cartCountEl.innerHTML = result;
                    // window.location.href = "#cartCount"; // এটি বাদ দেওয়া যেতে পারে, কারণ এটি পুরো পেজকে জাম্প করায়
                    cartToast.show();// ✅ এইখানে টোস্টটি শো করা হবে!
                } else {
                    alert("Something Wrong with adding To cart");
                }
            }
            catch (err) {
                console.log(err);
                alert("Please Login or Register to continue.");
            }
        }



        //To open side button click ok Buy now button
        function showProductDetailsAndBuy(productId) {
            // 1. Offcanvas ট্রিগার করা (উপরে দেওয়া প্রথম বাটনের কাজ)
            // 'productDetails' ID সহ offcanvas উপাদানটি নির্বাচন করুন
            var offcanvasElement = document.getElementById('productDetails');
            // Offcanvas instance তৈরি বা খুঁজে বের করুন (Bootstrap 5)
            var offcanvas = new bootstrap.Offcanvas(offcanvasElement);
            // Offcanvas দেখানো
            offcanvas.show();
            // এই লাইনটি আপনার পণ্য যোগ করার ফাংশনকে কল করবে
            add(productId);
        }



        //@*price range slider + reset button*@
            // ৪. স্লাইডার আপডেট লজিক (স্লাইডার সরালে টেক্সট ও ইনপুট চেঞ্জ হবে)
        function updateFromSlider(val) {
            // ইনপুট বক্স আপডেট
            document.getElementById("maxInput").value = val;
            
            // উপরের টেক্সট (Find With Price) আপডেট
            const priceDisplay = document.getElementById("priceValue");
            if (priceDisplay) {
                priceDisplay.innerText = val;
            }
        }

        // ৫. ইনপুট বক্স সিঙ্ক ও সাবমিট (টাইপ করলে স্লাইডার চেঞ্জ হবে)
        function syncSliderAndSubmit() {
            let minVal = parseFloat(document.getElementById("minInput").value) || 0;
            let maxVal = parseFloat(document.getElementById("maxInput").value) || 0;
            let slider = document.getElementById("priceSlider");

            // লজিক: মিনিমাম যদি ম্যাক্সিমাম থেকে বেশি হয়ে যায়
            if (minVal > maxVal) {
                // আমরা মিনিমামকেই ম্যাক্সিমাম এর সমান করে দিচ্ছি যাতে ইউজারকে বারবার অ্যালার্ট না দিতে হয়
                document.getElementById("minInput").value = maxVal;
            }

            // স্লাইডার এবং ডিসপ্লে টেক্সট আপডেট
            slider.value = maxVal;
            const priceDisplay = document.getElementById("priceValue");
            if (priceDisplay) {
                priceDisplay.innerText = maxVal;
            }

            // ফর্ম সাবমিট
            submitForm();
        }

        // ৬. ফাইনাল সাবমিট
        function submitForm() {
            document.getElementById("filterForm").submit();
        }

        //
    </script>
}
@*======================main Js=============*@































