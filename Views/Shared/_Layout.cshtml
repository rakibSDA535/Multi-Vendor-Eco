    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-toggler bg-info sticky-top py-3" style=" background-image: url(' /Images/');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;">
        @* <nav class="navbar navbar-expand-lg navbar-toggler bg-info "> *@
        <div class="container-fluid">
            <a class="navbar-brand" href="/Home/Index"><img src="/Images/pngtree-online-shop.png" height="150" width="150" /> </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Home/Index">
                            🏠Home
                            <span class="visually-hidden">(current)</span>
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @* সকল লগইন করা ইউজার নিজের অর্ডার দেখতে পারবে *@
                        <li class="nav-item">
                            <a class="nav-link" href="/UserOrder/UserOrders">📲My Orders</a>
                        </li>
                        @* শুধু অ্যাডমিন দেখবে *@
                        @if (User.IsInRole(Roles.Admin.ToString()))
                        {
                            <li class="nav-item"><a class="nav-link" href="/AdminOperations/Dashboard">🎬Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/AdminOperations/PendingManagers">🔔 Pending Approvals</a></li>
                            <li class="nav-item"><a class="nav-link" href="/AdminOperations/AllOrders">📜Orders</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Stock/Index">📈Stock</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Product/Index">🎁Products</a></li>
                        }

                        @* শুধু ম্যানেজার দেখবে *@
                        @if (User.IsInRole(Roles.Manager.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="vendorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Vendor  Pannel
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="vendorDropdown">
                                    <li><a class="dropdown-item" asp-controller="Vendor" asp-action="Index">🏢 Vendor Dashboard</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/Stock/Index">📈Stock</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vendor" asp-action="AddProduct">➕ Add New Product</a></li>
                                </ul>
                            </li>

                        }
                    }
                    

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">🗃️Type Of Product</a>
                        <div class="dropdown-menu">
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" style="background-color: yellow; color: black;">Fermecy</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Jhandu Bum</a>
                            <a class="dropdown-item" href="#">Hunjidal HC</a>
                            <a class="dropdown-item" href="#">Napa 10</a>
                            <a class="dropdown-item" href="#">Paracitamal</a>

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" style="background-color: yellow; color: black;">For Self</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Cloths</a>
                            <a class="dropdown-item" href="#">Hardwar goods</a>
                            <a class="dropdown-item" href="#">Glass Item</a>
                            <a class="dropdown-item" href="#">TV</a>
                            <a class="dropdown-item" href="#">Fridge</a>
                            <a class="dropdown-item" href="#">Furniture</a>

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" style="background-color: yellow; color: black;">For Kitchen</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Oven</a>
                            <a class="dropdown-item" href="#">Diasliy</a>
                            <a class="dropdown-item" href="#">Cooking pot/Boiler</a>

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" style="background-color: yellow; color: black;">For Bedroom</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Luxarious Bed</a>
                            <a class="dropdown-item" href="#">Sofa</a>
                            <a class="dropdown-item" href="#">Table</a>
                            <a class="dropdown-item" href="#">Almirah</a>

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" style="background-color: yellow; color: black;">For Decoration</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Fish Aqiuriam</a>
                            <a class="dropdown-item" href="#">Flowers</a>
                            <a class="dropdown-item" href="#">Wall Fram</a>
                            <a class="dropdown-item" href="#">Pet Animal</a>
                        </div>
                    </li>
                </ul>
                
                <partial name="_LoginPartial" />

            </div>
        </div>
    </nav>
    <div class="container">
        <div class="my-2">
            <partial name="_Notifications" />
        </div>
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>@*For Vendor/Manager Dropdown in Registration Form*@
</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
<script>
    loadCartCount();
    async function loadCartCount() {
    try {
    var response = await fetch(`/Cart/GetTotalItemInCart`);
    console.log(response)
    if (response.status == 200) {
    var result = await response.json();
    var cartCountEl = document.getElementById("cartCount");
    cartCountEl.innerHTML = result;
    }
    }
    catch (err) {
    console.log(err);
    }
    }
</script>
</html>

@await RenderSectionAsync("Scripts", required: false)

