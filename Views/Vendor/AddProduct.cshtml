@using Shop111.Models.DTOs
@model ProductDTO

@{
    ViewData["Title"] = "Add New Product (Vendor)";
    // যদি আপনি আলাদা লেআউট ব্যবহার করেন তবে তা এখানে সেট করুন
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-10 offset-md-1">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-shop me-2"></i>Post New Product</h4>
            <a asp-action="Index" class="btn btn-light btn-sm text-primary">Back to List</a>
        </div>
        <div class="card-body">
            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Basic Product Info -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductName" class="form-label fw-bold">Product Name*</label>
                        <input asp-for="ProductName" class="form-control" placeholder="Product name" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName" class="form-label fw-bold">Company/Brand*</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Brand name" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Category/Genre*</label>
                        <div class="input-group">
                            <select asp-for="GenreId" class="form-select" asp-items="@Model.GenreList">
                                <option value="">-- Select Category --</option>
                            </select>
                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#addGenreModal">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="GenreId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Price*</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Stock.Quantity" class="form-label fw-bold">Stock*</label>
                        <input asp-for="Stock.Quantity" type="number" class="form-control" />
                        <span asp-validation-for="Stock.Quantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ReleaseDate" class="form-label fw-bold">Release Date</label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Product Image*</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Detail Information (Master-Detail) -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-secondary">Product Specifications</h5>
                    <button type="button" id="addInfo" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus-circle"></i> Add More Detail
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover border" id="productInfoTable">
                        <thead class="table-light">
                            <tr>
                                <th>Description (e.g. Size, Color)</th>
                                <th>Made In</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        @* ভিউয়ের ভেতরে টেবিল বডির অংশটি এভাবে পরিবর্তন করুন *@
                        <tbody>
                            @if (Model.ProductInformations != null && Model.ProductInformations.Count > 0)
                            {
                                for (int i = 0; i < Model.ProductInformations.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input asp-for="ProductInformations[i].Id" type="hidden" />
                                            <textarea asp-for="ProductInformations[i].Description" class="form-control" rows="1"></textarea>
                                        </td>
                                        <td><input asp-for="ProductInformations[i].MadeIn" class="form-control" /></td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-info"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-center">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                        <i class="bi bi-cloud-arrow-up me-2"></i>Post Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Genre Modal -->
<div class="modal fade" id="addGenreModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Category Name</label>
                    <input type="text" id="newGenreName" class="form-control" placeholder="Enter Category Name" />
                    <small id="genreMessage" class="text-danger"></small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="saveNewGenre" class="btn btn-success">Save Category</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Row Template (Hidden) -->
<table style="display:none">
    <tbody id="infoRowTemplate">
        <tr>
            <td>
                <input name="ProductInformations[__idx__].Id" type="hidden" value="0" />
                <textarea name="ProductInformations[__idx__].Description" class="form-control" rows="1"></textarea>
            </td>
            <td><input name="ProductInformations[__idx__].MadeIn" class="form-control" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm remove-info"><i class="bi bi-trash"></i></button></td>
        </tr>
    </tbody>
</table>

