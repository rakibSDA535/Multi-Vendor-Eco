@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

        // ১. ইনডেক্স ঠিক করার ফাংশন
        function reindex() {
        $('#productInfoTable tbody tr').each(function (i, tr) {
        $(tr).find('input, textarea').each(function () {
        var name = $(this).attr('name');
        if (name) {
        var newName = name.replace(/ProductInformations\[\d+\]/, 'ProductInformations[' + i + ']');
        $(this).attr('name', newName);
        }
        });
        });
        }

        // ২. নতুন রো যোগ করা (Master-Detail)
        $('#addInfo').click(function (e) {
        e.preventDefault();

        var index = $('#productInfoTable tbody tr').length;
        var template = $('#infoRowTemplate').html();

        // __idx__ কে বর্তমান ইনডেক্স দিয়ে পরিবর্তন করা
        var html = template.replace(/__idx__/g, index);

        $('#productInfoTable tbody').append(html);
        reindex(); // নতুন রো যোগ করার পর ইনডেক্স চেক করা নিরাপদ
        });

        // ৩. রো ডিলিট করা (Event Delegation ব্যবহার করা হয়েছে)
        $(document).on('click', '.remove-info', function (e) {
        e.preventDefault();
        $(this).closest('tr').remove();
        reindex(); // ডিলিট করার পর অবশ্যই ইনডেক্স ঠিক করতে হবে
        });

        // ৪. Ajax দিয়ে নতুন ক্যাটাগরি (Genre) সেভ করা
        $('#saveNewGenre').click(function (e) {
        e.preventDefault();

        var btn = $(this); // btn ভেরিয়েবল ডিফাইন করা হলো
        var name = $('#newGenreName').val().trim();
        var messageArea = $('#genreMessage');
        var token = $('input[name="__RequestVerificationToken"]').val(); // টোকেন আলাদাভাবে নেওয়া হলো

        if (!name) {
        messageArea.text('Category name is required.').addClass('text-danger');
        return;
        }

        // বাটন ডিজেবল করা
        btn.prop('disabled', true).text('Saving...');

        $.ajax({
        url: '/Genre/CreateGenreAjax',
        type: 'POST',
        data: {
        genreName: name,
        "__RequestVerificationToken": token
        },
        success: function (response) {
        if (response.success) {
        var newOption = new Option(response.name, response.id, true, true);
        $('select[name="GenreId"]').append(newOption).trigger('change');

        $('#addGenreModal').modal('hide');
        $('#newGenreName').val('');
        messageArea.text('');
        } else {
        messageArea.text(response.message).addClass('text-danger');
        }
        },
        error: function(xhr) {
        // ৪0৩ বা ৪0৪ এরর হ্যান্ডেল করা
        messageArea.text('Error: ' + xhr.status + ' - Access Denied or Not Found.').addClass('text-danger');
        },
        complete: function() {
        btn.prop('disabled', false).text('Save Category');
        }
        });
        });
        });
    </script>
}