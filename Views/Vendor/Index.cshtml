@model Shop111.Models.Vendor
@{
    ViewData["Title"] = "Vendor Dashboard";
}

<div class="container-fluid mt-4 px-4">
    <!-- Top Statistics Cards (Like Image 3.jpg) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-bold">Total Products</div>
                        <div class="h2 fw-bold mb-0">@Model.Products.Count</div>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-bold">Shop Status</div>
                        <div class="h2 fw-bold mb-0">@(Model.IsLive ? "Live" : "Paused")</div>
                    </div>
                    <i class="bi bi-shop fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark shadow border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-black-50 text-uppercase fw-bold">Member Since</div>
                        <div class="h4 fw-bold mb-0">@Model.JoinDate?.ToString("MMM yyyy")</div>
                    </div>
                    <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white shadow border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-bold">Profile Status</div>
                        <div class="h2 fw-bold mb-0">Verified</div>
                    </div>
                    <i class="bi bi-patch-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Shop Info Section -->
        <div class="col-lg-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-body text-center py-5">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="@(string.IsNullOrEmpty(Model.VendorImage) ? "/uploads/no-image.png" : "/uploads/" + Model.VendorImage)"
                             class="rounded-circle shadow" style="width:150px; height:150px; object-fit:cover; border: 5px solid #f8f9fa;" />
                        <span class="position-absolute bottom-0 end-0 p-2 @(Model.IsLive ? "bg-success" : "bg-danger") border border-light rounded-circle"></span>
                    </div>
                    <h3 class="fw-bold">@Model.VendorName</h3>
                    <p class="text-muted small">@Model.VendorType Specialist</p>
                    <hr>
                    <div class="text-start px-3">
                        <p class="mb-2"><i class="bi bi-envelope me-2 text-primary"></i> <strong>Email:</strong> @Model.User.Email</p>
                        <p class="mb-2"><i class="bi bi-telephone me-2 text-primary"></i> <strong>Phone:</strong> @Model.VendorNumber</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-2 text-primary"></i> <strong>Address:</strong> @Model.VendorAddress</p>
                        <p class="mb-0"><i class="bi bi-envelope me-2 text-primary"></i> <strong>Vendor Email:</strong> @Model.VendorEmail</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-2 text-primary"></i> <strong>Vendor Description:</strong> @Model.VendorDescription</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-2 text-primary"></i> <strong>Vendor Location:</strong> @Model.Location?.City</p>

                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Product List Preview -->
        <div class="col-lg-8">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">Quick Management</h5>
                    <div class="btn-group">
                        <a asp-action="AddProduct" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Add Product</a>
                        <a asp-action="MyProducts" class="btn btn-sm btn-dark"><i class="bi bi-list-ul"></i> All Items</a>
                    </div>
                </div>
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Recent Activity Overview</h6>
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Company</th>
                                    <th>Create</th>
                                    <th>Stock</th>
                                    <th>Date</th>
                                    <th>OnSale</th>
                                    <th>Price</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Products.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <img src="/images/@item.Image" class="rounded" style="width:40px; height:40px; object-fit:cover;"
                                                 onerror="this.src='/uploads/no-image.png'" />
                                        </td>
                                        <td><span class="fw-semibold">@item.ProductName</span></td>
                                        <td><span class="badge bg-light text-dark border">@item.CompanyName</span></td>
                                        <td>@item.Genre?.GenreName</td>
                                        <td>@(item.Stock?.Quantity ?? 0)</td>
                                        <td>@item.ReleaseDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="badge @(item.OnSale ? "bg-success" : "bg-secondary")">
                                                @(item.OnSale ? "Yes" : "No")
                                            </span>
                                        </td>
                                        <td class="fw-bold">৳@item.Price</td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="UpdateProduct" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Edit</a>
                                                <a asp-action="ProductDetails" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detail</a>
                                                <a asp-action="DeleteProduct" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                                   onclick="return confirm('Delete this product?')">Delete</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Products.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">No products added yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Bootstrap Icons if not already present -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">