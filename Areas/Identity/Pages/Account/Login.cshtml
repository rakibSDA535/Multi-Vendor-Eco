@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="login-container d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg row g-0">
        
        <div class="col-lg-5 p-5 text-white d-flex flex-column justify-content-center text-center left-panel">
            <h2 class="fw-bold mb-3" style="color:black">Welcome Back!</h2>
            <p class="mb-4 opacity-75" style="color:black">Glad to see you again. Log in to access your account and explore new deals.</p>
            
            <div class="external-login-section mt-3">
                <p class="small mb-3" style="color:black">Quick login with:</p>
                @{
                    if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-light rounded-pill btn-sm" name="provider" value="@provider.Name">
                                        Continue with @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="bg-white bg-opacity-10 p-2 rounded small" style="color:black">Social login unavailable</div>
                    }
                }
            </div>
        </div>

        <div class="col-lg-7 p-5 bg-white">
            <h3 class="fw-bold mb-4" style="color: #2bcde2;">Sign In</h3>
            
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                <div class="form-floating mb-3 custom-input">
                    <input asp-for="Input.Email" class="form-control border-0 border-bottom rounded-0 px-0" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="ps-0">Email Address</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 custom-input">
                    <input asp-for="Input.Password" class="form-control border-0 border-bottom rounded-0 px-0" placeholder="password" />
                    <label asp-for="Input.Password" class="ps-0">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label small text-muted" asp-for="Input.RememberMe">
                            Remember Me
                        </label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none" style="color: #2bcde2;">Forgot Password?</a>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-login text-white fw-bold py-3 shadow mb-4">Sign In</button>

                <div class="text-center">
                    <p class="small text-muted mb-1">Don't have an account?</p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none" style="color: #0099ad;">Register Now</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    /* Container padding */
    .login-container {
        min-height: 85vh;
        padding: 30px 15px;
    }

    /* Card Styling */
    .login-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        max-width: 900px;
        width: 100%;
        border: none;
    }

    /* Left Gradient Panel */
    .left-panel {
        background: linear-gradient(135deg, #2bcde2 0%, #b2edff 100%);
    }

    /* Minimalist Inputs */
    .custom-input .form-control {
        background-color: transparent;
    }

        .custom-input .form-control:focus {
            box-shadow: none;
            border-color: #2bcde2 !important;
        }

    /* Button Styling */
    .btn-login {
        background: linear-gradient(45deg, #2bcde2, #0099ad);
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(43, 205, 226, 0.4) !important;
        }

    /* Links Hover */
    a:hover {
        opacity: 0.8;
    }
</style>