    </div>
</div>

@section Scripts{

<partial name="_ValidationScriptsPartial" />

<script>

    $(document).ready(function () {

    function toggleVendorSection() {

        let selectedRole = $("#roleSelect").val();

        if (selectedRole === "Manager") {

            $("#vendorSection").slideDown();

            $("#vendorNameInput").prop("required", true);

            $("#tradeLicenseInput").prop("required", true);
        }
        else {

            $("#vendorSection").slideUp();

            $("#vendorNameInput").prop("required", false).val("");

            $("#tradeLicenseInput").prop("required", false).val("");
        }
    }

    toggleVendorSection();

    $("#roleSelect").change(function () {

        toggleVendorSection();

    });
});

</script>
}

<style>
    body { background-color: #f4f7f8; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .register-container { min-height: 90vh; }
    .register-card { background: #fff; border-radius: 25px; overflow: hidden; max-width: 1000px; width: 100%; border: none; }
    .right-panel { background: linear-gradient(135deg, #2bcde2 0%, #0099ad 100%); }
    .custom-input .form-control, .custom-input .form-select { box-shadow: none !important; border-bottom: 2px solid #eee !important; }
    .custom-input .form-control:focus, .custom-input .form-select:focus { border-bottom-color: #2bcde2 !important; }
    .btn-register { background: linear-gradient(45deg, #2bcde2, #0099ad); border: none; border-radius: 12px; transition: all 0.3s; }
    .btn-register:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(43, 205, 226, 0.4); }
</style> *@



