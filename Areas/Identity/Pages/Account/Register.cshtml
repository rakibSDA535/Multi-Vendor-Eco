            @section Scripts {

                <partial name="_ValidationScriptsPartial" />

                <script>

                    $(document).ready(function () {

                        function toggleVendorSection() {

                            let selectedRole =
                                $("#roleSelect").val();

                            console.log(selectedRole);

                            if (selectedRole === "Manager") {

                                $("#vendorSection")
                                    .stop(true, true)
                                    .slideDown(400);

                                $("#vendorNameInput")
                                    .prop("required", true);

                                $("#tradeLicenseInput")
                                    .prop("required", true);
                            }
                            else {

                                $("#vendorSection")
                                    .stop(true, true)
                                    .slideUp(300);

                                $("#vendorNameInput")
                                    .prop("required", false)
                                    .val("");

                                $("#tradeLicenseInput")
                                    .prop("required", false)
                                    .val("");
                            }
                        }

                        toggleVendorSection();

                        $("#roleSelect").change(function () {

                            toggleVendorSection();

                        });

                    });

                </script>
            }
