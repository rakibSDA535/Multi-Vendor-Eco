                        <div class="form-floating custom-input">
                            <input asp-for="Input.Email" class="form-control border-0 border-bottom rounded-0 px-0" placeholder="Email" />
                            <label asp-for="Input.Email" class="ps-0">Email Address</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
