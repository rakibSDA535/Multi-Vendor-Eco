@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-container d-flex align-items-center justify-content-center py-5">
    <div class="register-card shadow-lg row g-0">

        <!-- LEFT -->
        <div class="col-lg-8 p-4 p-md-5 bg-white">

            <h2 class="fw-bold mb-1 text-info">
                Join Us Today!
            </h2>

            <p class="text-muted mb-4">
                Create your account to start shopping or selling.
            </p>

            <form id="registerForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- ROLE -->
                    <div class="col-md-12 mb-3">

                        <div class="form-floating custom-input">

                            <select asp-for="Input.Role"
                                    asp-items="Model.RoleList"
                                    id="roleSelect"
                                    class="form-select border-0 border-bottom rounded-0 px-0">

                                <option value="">
                                    --- Choose Your Role ---
                                </option>

                            </select>

                            <label asp-for="Input.Role">
                                Register As
                            </label>

                        </div>

                        <span asp-validation-for="Input.Role"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- FULL NAME -->
                    <div class="col-md-12 mb-3">

                        <div class="form-floating custom-input">

                            <input asp-for="Input.FullName"
                                   class="form-control border-0 border-bottom rounded-0 px-0" />

                            <label asp-for="Input.FullName"></label>

                        </div>

                        <span asp-validation-for="Input.FullName"
                              class="text-danger small">
                        </span>

                    </div>
                    

                    <!-- EMAIL -->
                    <div class="col-md-6 mb-3">

                        <div class="form-floating custom-input">

                            <input asp-for="Input.Email"
                                   class="form-control border-0 border-bottom rounded-0 px-0" />

                            <label asp-for="Input.Email"></label>

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- PHONE -->
                    <div class="col-md-6 mb-3">

                        <div class="form-floating custom-input">

                            <input asp-for="Input.PhoneNumber"
                                   class="form-control border-0 border-bottom rounded-0 px-0" />

                            <label asp-for="Input.PhoneNumber"></label>

                        </div>

                        <span asp-validation-for="Input.PhoneNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- PASSWORD -->
                    <div class="col-md-6 mb-3">

                        <div class="form-floating custom-input">

                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control border-0 border-bottom rounded-0 px-0" />

                            <label asp-for="Input.Password"></label>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="col-md-6 mb-3">

                        <div class="form-floating custom-input">

                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   class="form-control border-0 border-bottom rounded-0 px-0" />

                            <label asp-for="Input.ConfirmPassword"></label>

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>
                    <!-- Date -->
                    <div class="col-md-6 mb-3">
                        <div class="form-floating custom-input">
                            <input asp-for="Input.JoinDate"
                                   type="date"
                                   class="form-control border-0 border-bottom bg-transparent rounded-0 px-0" />

                            <label asp-for="Input.JoinDate" class="ps-0">
                                Join Date
                            </label>

                            <span asp-validation-for="Input.JoinDate"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                </div>

                <!-- VENDOR SECTION -->
                <div id="vendorSection"
                     class="p-4 mb-4 rounded-3"
                     style="display:none;background:#f8fdff;border:1px dashed #2bcde2;">

                    <h5 class="mb-4 text-info">
                        Vendor Information
                    </h5>

                    <div class="row">

                        <!-- Vendor Name -->
                        <div class="col-md-6 mb-3">
                            <div class="form-floating custom-input">

                                <input asp-for="Input.VendorName"
                                       id="vendorNameInput"
                                       class="form-control border-0 border-bottom bg-transparent rounded-0 px-0" />

                                <label asp-for="Input.VendorName"></label>

                            </div>
                        </div>
                        <div class="col-md-6 mb-3">

                            <div class="form-floating custom-input">

                                <input asp-for="Input.VendorEmail"
                                       class="form-control border-0 border-bottom rounded-0 px-0" />

                                <label asp-for="Input.VendorEmail"></label>

                            </div>

                            <span asp-validation-for="Input.VendorEmail"
                                  class="text-danger small">
                            </span>

                        </div>
                        <!-- Vendor Type -->
                        <div class="col-md-6 mb-3">
                            <div class="form-floating custom-input">

                                <input asp-for="Input.VendorType"
                                       class="form-control border-0 border-bottom bg-transparent rounded-0 px-0" />

                                <label asp-for="Input.VendorType"></label>

                            </div>
                        </div>

                        <!-- Trade License -->
                        <div class="col-md-6 mb-3">
                            <div class="form-floating custom-input">

                                <input asp-for="Input.TradeLicenceNo"
                                       id="tradeLicenseInput"
                                       class="form-control border-0 border-bottom bg-transparent rounded-0 px-0" />

                                <label asp-for="Input.TradeLicenceNo"></label>

                            </div>
                        </div>

                        <!-- Location -->
                        <div class="col-md-6 mb-3">
                            <div class="form-floating custom-input">

                                <select asp-for="Input.LocationId"
                                        asp-items="Model.LocationList"
                                        class="form-select border-0 border-bottom rounded-0 px-0">

                                    <option value="">
                                        Select Location
                                    </option>

                                </select>

                                <label asp-for="Input.LocationId"></label>

                            </div>
                        </div>
                        

                        <!-- Vendor Address -->
                        <div class="col-md-12 mb-3">
                            <div class="form-floating custom-input">

                                <textarea asp-for="Input.VendorAddress"
                                          class="form-control"
                                              style="height:100px">
                                </textarea>

                                    <label asp-for="Input.VendorAddress"></label>

                                </div>
                            </div>

                            <!-- Vendor Description -->
                            <div class="col-md-12 mb-3">
                                <div class="form-floating custom-input">

                                    <textarea asp-for="Input.VendorDescription"
                                              class="form-control"
                                                  style="height:120px">
                                    </textarea>

                                        <label asp-for="Input.VendorDescription"></label>

                                    </div>
                                </div>

                                <!-- Owner Description -->
                                <div class="col-md-12 mb-3">
                                    <div class="form-floating custom-input">

                                        <textarea asp-for="Input.OwnerDescription"
                                                  class="form-control"
                                                      style="height:100px">
                                        </textarea>

                                            <label asp-for="Input.OwnerDescription"></label>

                                        </div>
                                    </div>

                                    <!-- Vendor Image -->
                                    <div class="col-md-6 mb-3">

                                        <label class="fw-bold mb-2">
                                            Vendor Image
                                        </label>

                                        <input asp-for="Input.VendorImage"
                                               type="file"
                                               class="form-control" />

                                    </div>

                                    
                                    <!-- Owner Image -->
                                    <div class="col-md-6 mb-3">

                                        <label class="fw-bold mb-2">
                                            Owner Image
                                        </label>

                                        <input asp-for="Input.OwnerImage"
                                               type="file"
                                               class="form-control" />

                                    </div>

                                </div>

                            </div>

                            <!-- BUTTON -->
                            <button type="submit"
                                    class="w-100 btn btn-register text-white fw-bold py-3 shadow-sm mt-3">

                                Create My Account

                            </button>

                        </form>

                    </div>

                    <!-- RIGHT -->
                    <div class="col-lg-4 p-5 text-white d-flex flex-column justify-content-center text-center right-panel">

                        <div class="mb-4">
                            <i class="bi bi-person-plus-fill"
                                   style="font-size:3rem;">
                            </i>
                        </div>

                        <h3 class="mb-3">
                            Already a Member?
                        </h3>

                        <p class="mb-4 opacity-75 small">
                            Sign in to access your dashboard.
                        </p>

                        <a asp-page="./Login"
                               class="btn btn-outline-light rounded-pill px-4 mb-5">

                            Sign In

                        </a>

                    </div>

                </div>
            </div>
